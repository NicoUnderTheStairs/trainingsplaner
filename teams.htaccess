# Deploy this file as "teams/.htaccess" on the server (rename on upload).
# It blocks direct browser access to uploaded ID files — they may only be
# retrieved through download.php with a valid X-Download-Token header.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
